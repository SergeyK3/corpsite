# Copy to /etc/corpsite-learn/backend.env, chmod 600, owner corpsite-learn.
# Supply independent secrets; never reuse production or test values.
APP_ENV=prod
CORPSITE_SKIP_DOTENV=1
DATABASE_URL=postgresql+psycopg2://corpsite_learn_app:REPLACE_PASSWORD@127.0.0.1:5432/corpsite_learn
TRAINING_SERVER_ENABLED=1
TRAINING_MODE=1
TRAINING_DISABLE_EXTERNAL=1
PERSONNEL_PHOTO_STORAGE_ROOT=/var/lib/corpsite-learn/photos
PERSONNEL_FILE_STORAGE_ROOT=/var/lib/corpsite-learn/files
PERSONNEL_FILE_SCAN_COMMAND=/usr/bin/clamscan --no-summary
LEARNING_PILOT_ENABLED=1
HIRE_PATH_REHEARSAL=1
CORPSITE_TRAINING_UNIT_ID=REPLACE_TRAINING_UNIT_ID
CORPSITE_TRAINING_PARENT_UNIT_ID=REPLACE_TRAINING_PARENT_UNIT_ID
CORPSITE_TRAINING_POSITION_ID=REPLACE_TRAINING_POSITION_ID
# Attach the approved, frozen course file before enabling the guide link.
# LEARNING_APPROVED_GUIDE_PATH=/var/lib/corpsite-learn/guides/branch_admin_v1-approved.pdf
# LEARNING_APPROVED_GUIDE_VERSION=3
CORS_ALLOWED_ORIGINS=https://learn.mmc.004.kz
AUTH_JWT_SECRET=REPLACE_UNIQUE_SECRET
INTERNAL_API_TOKEN=REPLACE_UNIQUE_SECRET
BOT_BIND_TOKEN=REPLACE_UNIQUE_SECRET
PERSONNEL_INTAKE_TOKEN_ENCRYPTION_KEY=REPLACE_UNIQUE_SECRET
# No BOT_TOKEN or SMTP credentials. No corpsite-bot service or regular-tasks timer.
